@page
@model SyncBridge.Core.Pages.Orders.CreateModel
@{ ViewData["Title"] = "Create production order"; }
<h1>Create production order</h1>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form method="post">
    <label asp-for="OrderNumber"></label><input asp-for="OrderNumber" class="form-control" />
    <label asp-for="ProductCode"></label><input asp-for="ProductCode" class="form-control" />
    <label asp-for="ProductName"></label><input asp-for="ProductName" class="form-control" />
    <label asp-for="RecipeCode">Approved recipe code</label><input asp-for="RecipeCode" class="form-control" />
    <label asp-for="Quantity"></label><input asp-for="Quantity" type="number" step="0.001" min="0.001" class="form-control" />
    <button class="btn btn-primary mt-3">Create order</button>
</form>
