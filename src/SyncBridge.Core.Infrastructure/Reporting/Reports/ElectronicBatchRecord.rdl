    <DataSet Name="Signatures">
      <Query>
        <DataSourceName>Manufacturing</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BatchId">
            <Value>=Parameters!BatchId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT COALESCE(CONVERT(nvarchar(max),s.SignatureId,127),N'Not recorded') AS [SignatureId],
 COALESCE(CONVERT(nvarchar(max),s.RelatedRecordType,127),N'Not recorded') AS [RelatedRecordType],
 COALESCE(CONVERT(nvarchar(max),s.RelatedRecordId,127),N'Not recorded') AS [RelatedRecordId],
 COALESCE(CONVERT(nvarchar(max),s.UserId,127),N'Not recorded') AS [UserId],
 COALESCE(CONVERT(nvarchar(max),u.UserName,127),N'Not recorded') AS [UserName],
 COALESCE(CONVERT(nvarchar(max),u.DisplayName,127),N'Not recorded') AS [DisplayName],
 COALESCE(CONVERT(nvarchar(max),s.Meaning,127),N'Not recorded') AS [Meaning],
 COALESCE(CONVERT(nvarchar(max),s.SignedAt,127),N'Not recorded') AS [SignedAt]
FROM dbo.Batch b JOIN dbo.ElectronicSignature s ON s.BatchId=b.BatchId LEFT JOIN dbo.AppUser u ON u.UserId=s.UserId
WHERE b.BatchId=TRY_CONVERT(uniqueidentifier,@BatchId) AND DATALENGTH(CONVERT(nvarchar(max),@BatchId))=72 AND b.Status=N'Completed'
ORDER BY s.SignedAt,s.SignatureId;</CommandText>
        <Timeout>30</Timeout>
      </Query>
      <Fields>
        <Field Name="SignatureId">
          <DataField>SignatureId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RelatedRecordType">
          <DataField>RelatedRecordType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RelatedRecordId">
          <DataField>RelatedRecordId</DataField>
