    <DataSet Name="Audit">
      <Query>
        <DataSourceName>Manufacturing</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BatchId">
            <Value>=Parameters!BatchId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT COALESCE(CONVERT(nvarchar(max),a.AuditEventId,127),N'Not recorded') AS [AuditEventId],
 COALESCE(CONVERT(nvarchar(max),a.UserId,127),N'Not recorded') AS [UserId],
 COALESCE(CONVERT(nvarchar(max),u.UserName,127),N'Not recorded') AS [UserName],
 COALESCE(CONVERT(nvarchar(max),u.DisplayName,127),N'Not recorded') AS [DisplayName],
 COALESCE(CONVERT(nvarchar(max),a.Action,127),N'Not recorded') AS [Action],
 COALESCE(CONVERT(nvarchar(max),a.AffectedEntity,127),N'Not recorded') AS [AffectedEntity],
 COALESCE(CONVERT(nvarchar(max),a.AffectedEntityId,127),N'Not recorded') AS [AffectedEntityId],
 COALESCE(CONVERT(nvarchar(max),a.OccurredAt,127),N'Not recorded') AS [OccurredAt],
 COALESCE(CONVERT(nvarchar(max),a.ResultingState,127),N'Not recorded') AS [ResultingState],
 COALESCE(CONVERT(nvarchar(max),a.Details,127),N'Not recorded') AS [Details]
FROM dbo.Batch b JOIN dbo.AuditEvent a ON a.BatchId=b.BatchId LEFT JOIN dbo.AppUser u ON u.UserId=a.UserId
WHERE b.BatchId=TRY_CONVERT(uniqueidentifier,@BatchId) AND DATALENGTH(CONVERT(nvarchar(max),@BatchId))=72 AND b.Status=N'Completed'
ORDER BY a.OccurredAt,a.AuditEventId;</CommandText>
        <Timeout>30</Timeout>
      </Query>
      <Fields>
        <Field Name="AuditEventId">
          <DataField>AuditEventId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UserId">
          <DataField>UserId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UserName">
          <DataField>UserName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DisplayName">
          <DataField>DisplayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Action">
          <DataField>Action</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AffectedEntity">
