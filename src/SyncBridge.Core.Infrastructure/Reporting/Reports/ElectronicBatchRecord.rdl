<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Completed-batch EBR from the approved normalized operational evidence. Read-only SSRS rendering.</Description>
  <DataSources>
    <DataSource Name="Manufacturing">
      <DataSourceReference>/SyncBridge/SyncBridgeCoreReadOnly</DataSourceReference>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Identification">
      <Query>
        <DataSourceName>Manufacturing</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BatchId">
            <Value>=Parameters!BatchId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT COALESCE(CONVERT(nvarchar(max),b.BatchId,127),N'Not recorded') AS [BatchId],
 COALESCE(CONVERT(nvarchar(max),b.BatchNumber,127),N'Not recorded') AS [BatchNumber],
 COALESCE(CONVERT(nvarchar(max),b.Status,127),N'Not recorded') AS [BatchStatus],
 COALESCE(CONVERT(nvarchar(max),b.CreatedAt,127),N'Not recorded') AS [CreatedAt],
 COALESCE(CONVERT(nvarchar(max),b.StartedAt,127),N'Not recorded') AS [StartedAt],
 COALESCE(CONVERT(nvarchar(max),b.CompletedAt,127),N'Not recorded') AS [CompletedAt],
 COALESCE(CONVERT(nvarchar(max),b.FinalDisposition,127),N'Not recorded') AS [FinalDisposition],
 COALESCE(CONVERT(nvarchar(max),o.OrderId,127),N'Not recorded') AS [OrderId],
 COALESCE(CONVERT(nvarchar(max),o.OrderNumber,127),N'Not recorded') AS [OrderNumber],
 COALESCE(CONVERT(nvarchar(max),o.ProductCode,127),N'Not recorded') AS [ProductCode],
 COALESCE(CONVERT(nvarchar(max),o.ProductName,127),N'Not recorded') AS [ProductName],
 COALESCE(CONVERT(nvarchar(max),o.Quantity,127),N'Not recorded') AS [PlannedQuantity],
 COALESCE(CONVERT(nvarchar(max),o.Status,127),N'Not recorded') AS [OrderStatus],
 COALESCE(CONVERT(nvarchar(max),r.RecipeId,127),N'Not recorded') AS [RecipeId],
 COALESCE(CONVERT(nvarchar(max),r.RecipeCode,127),N'Not recorded') AS [RecipeCode],
 COALESCE(CONVERT(nvarchar(max),r.Name,127),N'Not recorded') AS [RecipeName],
 COALESCE(CONVERT(nvarchar(max),r.Version,127),N'Not recorded') AS [RecipeVersion],
 COALESCE(CONVERT(nvarchar(max),SUSER_SNAME(),127),N'Not recorded') AS [ExecutionIdentity]
FROM dbo.Batch b JOIN dbo.ProductionOrder o ON o.OrderId=b.OrderId JOIN dbo.Recipe r ON r.RecipeId=o.RecipeId
WHERE b.BatchId=TRY_CONVERT(uniqueidentifier,@BatchId) AND DATALENGTH(CONVERT(nvarchar(max),@BatchId))=72 AND b.Status=N'Completed'
ORDER BY b.BatchId;</CommandText>
        <Timeout>30</Timeout>
      </Query>
      <Fields>
        <Field Name="BatchId">
          <DataField>BatchId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BatchNumber">
          <DataField>BatchNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BatchStatus">
          <DataField>BatchStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CreatedAt">
          <DataField>CreatedAt</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartedAt">
          <DataField>StartedAt</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CompletedAt">
          <DataField>CompletedAt</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FinalDisposition">
          <DataField>FinalDisposition</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderId">
          <DataField>OrderId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderNumber">
          <DataField>OrderNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProductCode">
          <DataField>ProductCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProductName">
          <DataField>ProductName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PlannedQuantity">
          <DataField>PlannedQuantity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderStatus">
          <DataField>OrderStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RecipeId">
          <DataField>RecipeId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RecipeCode">
          <DataField>RecipeCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RecipeName">
          <DataField>RecipeName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RecipeVersion">
          <DataField>RecipeVersion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ExecutionIdentity">
          <DataField>ExecutionIdentity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Workflow">
      <Query>
        <DataSourceName>Manufacturing</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BatchId">
            <Value>=Parameters!BatchId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT COALESCE(CONVERT(nvarchar(max),s.StepNumber,127),N'Not recorded') AS [StepNumber],
 COALESCE(CONVERT(nvarchar(max),s.StepExecutionId,127),N'Not recorded') AS [StepExecutionId],
 COALESCE(CONVERT(nvarchar(max),s.RecipeStepId,127),N'Not recorded') AS [RecipeStepId],
 COALESCE(CONVERT(nvarchar(max),r.Name,127),N'Not recorded') AS [StepName],
 COALESCE(CONVERT(nvarchar(max),r.Instructions,127),N'Not recorded') AS [Instructions],
 COALESCE(CONVERT(nvarchar(max),r.RequiresSignature,127),N'Not recorded') AS [RequiresSignature],
 COALESCE(CONVERT(nvarchar(max),s.Status,127),N'Not recorded') AS [ExecutionStatus],
 COALESCE(CONVERT(nvarchar(max),s.StartedAt,127),N'Not recorded') AS [StartedAt],
 COALESCE(CONVERT(nvarchar(max),s.CompletedAt,127),N'Not recorded') AS [CompletedAt],
 COALESCE(CONVERT(nvarchar(max),s.CompletedByUserId,127),N'Not recorded') AS [CompletedByUserId],
 COALESCE(CONVERT(nvarchar(max),u.DisplayName,127),N'Not recorded') AS [CompletedByName],
 COALESCE(CONVERT(nvarchar(max),s.RecordedData,127),N'Not recorded') AS [RecordedData]
FROM dbo.Batch b JOIN dbo.BatchStepExecution s ON s.BatchId=b.BatchId JOIN dbo.RecipeStep r ON r.RecipeStepId=s.RecipeStepId LEFT JOIN dbo.AppUser u ON u.UserId=s.CompletedByUserId
WHERE b.BatchId=TRY_CONVERT(uniqueidentifier,@BatchId) AND DATALENGTH(CONVERT(nvarchar(max),@BatchId))=72 AND b.Status=N'Completed'
ORDER BY s.StepNumber,s.StepExecutionId;</CommandText>
        <Timeout>30</Timeout>
      </Query>
      <Fields>
        <Field Name="StepNumber">
          <DataField>StepNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StepExecutionId">
          <DataField>StepExecutionId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RecipeStepId">
          <DataField>RecipeStepId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StepName">
          <DataField>StepName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Instructions">
          <DataField>Instructions</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RequiresSignature">
          <DataField>RequiresSignature</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ExecutionStatus">
          <DataField>ExecutionStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartedAt">
          <DataField>StartedAt</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CompletedAt">
          <DataField>CompletedAt</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CompletedByUserId">
          <DataField>CompletedByUserId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CompletedByName">
          <DataField>CompletedByName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RecordedData">
          <DataField>RecordedData</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Materials">
      <Query>
        <DataSourceName>Manufacturing</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BatchId">
            <Value>=Parameters!BatchId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT COALESCE(CONVERT(nvarchar(max),v.VerificationId,127),N'Not recorded') AS [VerificationId],
 COALESCE(CONVERT(nvarchar(max),v.MaterialId,127),N'Not recorded') AS [MaterialId],
 COALESCE(CONVERT(nvarchar(max),m.MaterialCode,127),N'Not recorded') AS [MaterialCode],
 COALESCE(CONVERT(nvarchar(max),m.Name,127),N'Not recorded') AS [MaterialName],
 COALESCE(CONVERT(nvarchar(max),v.LotNumber,127),N'Not recorded') AS [LotNumber],
 COALESCE(CONVERT(nvarchar(max),v.IsAccepted,127),N'Not recorded') AS [IsAccepted],
 COALESCE(CONVERT(nvarchar(max),v.VerifiedByUserId,127),N'Not recorded') AS [VerifiedByUserId],
 COALESCE(CONVERT(nvarchar(max),u.DisplayName,127),N'Not recorded') AS [VerifiedByName],
 COALESCE(CONVERT(nvarchar(max),v.VerifiedAt,127),N'Not recorded') AS [VerifiedAt],
 COALESCE(CONVERT(nvarchar(max),v.Comments,127),N'Not recorded') AS [Comments]
FROM dbo.Batch b JOIN dbo.MaterialVerification v ON v.BatchId=b.BatchId JOIN dbo.Material m ON m.MaterialId=v.MaterialId LEFT JOIN dbo.AppUser u ON u.UserId=v.VerifiedByUserId
WHERE b.BatchId=TRY_CONVERT(uniqueidentifier,@BatchId) AND DATALENGTH(CONVERT(nvarchar(max),@BatchId))=72 AND b.Status=N'Completed'
ORDER BY v.VerifiedAt,v.VerificationId;</CommandText>
        <Timeout>30</Timeout>
      </Query>
      <Fields>
        <Field Name="VerificationId">
          <DataField>VerificationId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MaterialId">
          <DataField>MaterialId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MaterialCode">
          <DataField>MaterialCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MaterialName">
          <DataField>MaterialName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LotNumber">
          <DataField>LotNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IsAccepted">
          <DataField>IsAccepted</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VerifiedByUserId">
          <DataField>VerifiedByUserId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VerifiedByName">
          <DataField>VerifiedByName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VerifiedAt">
          <DataField>VerifiedAt</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Comments">
          <DataField>Comments</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Equipment">
      <Query>
        <DataSourceName>Manufacturing</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BatchId">
            <Value>=Parameters!BatchId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT COALESCE(CONVERT(nvarchar(max),v.VerificationId,127),N'Not recorded') AS [VerificationId],
 COALESCE(CONVERT(nvarchar(max),v.EquipmentId,127),N'Not recorded') AS [EquipmentId],
 COALESCE(CONVERT(nvarchar(max),e.EquipmentCode,127),N'Not recorded') AS [EquipmentCode],
 COALESCE(CONVERT(nvarchar(max),e.Name,127),N'Not recorded') AS [EquipmentName],
 COALESCE(CONVERT(nvarchar(max),e.CalibrationDueDate,127),N'Not recorded') AS [CalibrationDueDate],
 COALESCE(CONVERT(nvarchar(max),v.IsReady,127),N'Not recorded') AS [IsReady],
 COALESCE(CONVERT(nvarchar(max),v.CalibrationValid,127),N'Not recorded') AS [CalibrationValid],
 COALESCE(CONVERT(nvarchar(max),v.VerifiedByUserId,127),N'Not recorded') AS [VerifiedByUserId],
 COALESCE(CONVERT(nvarchar(max),u.DisplayName,127),N'Not recorded') AS [VerifiedByName],
 COALESCE(CONVERT(nvarchar(max),v.VerifiedAt,127),N'Not recorded') AS [VerifiedAt],
 COALESCE(CONVERT(nvarchar(max),v.Comments,127),N'Not recorded') AS [Comments]
FROM dbo.Batch b JOIN dbo.EquipmentVerification v ON v.BatchId=b.BatchId JOIN dbo.Equipment e ON e.EquipmentId=v.EquipmentId LEFT JOIN dbo.AppUser u ON u.UserId=v.VerifiedByUserId
WHERE b.BatchId=TRY_CONVERT(uniqueidentifier,@BatchId) AND DATALENGTH(CONVERT(nvarchar(max),@BatchId))=72 AND b.Status=N'Completed'
ORDER BY v.VerifiedAt,v.VerificationId;</CommandText>
