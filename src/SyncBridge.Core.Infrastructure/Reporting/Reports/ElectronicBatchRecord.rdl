    <DataSet Name="Deviations">
      <Query>
        <DataSourceName>Manufacturing</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@BatchId">
            <Value>=Parameters!BatchId.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT COALESCE(CONVERT(nvarchar(max),d.DeviationId,127),N'Not recorded') AS [DeviationId],
 COALESCE(CONVERT(nvarchar(max),d.DeviationCode,127),N'Not recorded') AS [DeviationCode],
 COALESCE(CONVERT(nvarchar(max),d.StepExecutionId,127),N'Not recorded') AS [StepExecutionId],
 COALESCE(CONVERT(nvarchar(max),d.Description,127),N'Not recorded') AS [Description],
 COALESCE(CONVERT(nvarchar(max),d.Status,127),N'Not recorded') AS [DeviationStatus],
 COALESCE(CONVERT(nvarchar(max),d.ReportedByUserId,127),N'Not recorded') AS [ReportedByUserId],
 COALESCE(CONVERT(nvarchar(max),u.DisplayName,127),N'Not recorded') AS [ReportedByName],
 COALESCE(CONVERT(nvarchar(max),d.OpenedAt,127),N'Not recorded') AS [OpenedAt],
 COALESCE(CONVERT(nvarchar(max),d.ReviewComments,127),N'Not recorded') AS [ReviewComments],
 COALESCE(CONVERT(nvarchar(max),d.FinalDisposition,127),N'Not recorded') AS [FinalDisposition],
 COALESCE(CONVERT(nvarchar(max),d.ResolvedAt,127),N'Not recorded') AS [ResolvedAt]
FROM dbo.Batch b JOIN dbo.Deviation d ON d.BatchId=b.BatchId LEFT JOIN dbo.AppUser u ON u.UserId=d.ReportedByUserId
WHERE b.BatchId=TRY_CONVERT(uniqueidentifier,@BatchId) AND DATALENGTH(CONVERT(nvarchar(max),@BatchId))=72 AND b.Status=N'Completed'
ORDER BY d.OpenedAt,d.DeviationId;</CommandText>
        <Timeout>30</Timeout>
      </Query>
